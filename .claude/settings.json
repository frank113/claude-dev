{
	"$schema": "https://json.schemastore.org/claude-code-settings.json",
	"permissions": {
	  "allow": [
		  "Bash(jq *)",
		  "Bash(terraform plan)",
		  "Bash(terraform fmt)",
		  "Bash(terraform validate)",
		"Bash(npm run lint)",
		"Bash(npm run test *)",
		"Read(~/.zshrc)"
	  ],
	  "deny": [
		  "Bash(git add *)",
		  "Bash(git commit:*)",
		"Bash(terraform apply)",
		"Bash(terraform destroy)",
		"Read(./.env)",
		"Read(./.env.*)",
		"Read(./secrets/**)"
	  ]
	},
	"env": {
	  "CLAUDE_CODE_ENABLE_TELEMETRY": "0",
	  "OTEL_METRICS_EXPORTER": "otlp"
	},
	"companyAnnouncements": [
	  "Welcome to the Walt Disney Company! On the data platform team we value code that is readable, safe and securty above all else. "
	]
  }